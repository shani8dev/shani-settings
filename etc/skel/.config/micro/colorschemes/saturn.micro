# Saturn - ShaniOS micro colour scheme. Uses the terminal's 16 ANSI colours,
# which the shipped Saturn / Saturn Dark Konsole schemes define, so it is
# right in both light and dark; no background on `default`, so a
# translucent terminal stays translucent.
color-link default "default"
color-link comment "italic brightblack"
color-link identifier "cyan"
color-link constant "yellow"
color-link constant.string "green"
color-link constant.string.char "green"
color-link constant.number "yellow"
color-link constant.bool "bold yellow"
color-link constant.specialChar "magenta"
color-link statement "bold red"
color-link symbol "magenta"
color-link symbol.operator "magenta"
color-link symbol.brackets "default"
color-link preproc "brightred"
color-link type "magenta"
color-link type.keyword "bold red"
color-link special "yellow"
color-link underlined "underline cyan"
color-link error "bold white,red"
color-link todo "bold black,yellow"
color-link hlsearch "black,yellow"
color-link match-brace "bold reverse"
color-link statusline "reverse"
color-link statusline.inactive "brightblack"
color-link statusline.suggestions "reverse"
color-link tabbar "brightblack"
color-link tabbar.active "bold reverse"
color-link indent-char "brightblack"
color-link line-number "brightblack"
color-link current-line-number "bold red"
color-link gutter-error "red"
color-link gutter-warning "yellow"
color-link diff-added "green"
color-link diff-modified "yellow"
color-link diff-deleted "red"
color-link divider "brightblack"
color-link scrollbar "brightblack"
color-link message "default"
color-link error-message "bold red"
