# ~/.bashrc - ShaniOS (installed as ~/.bashrc on first login)
# If not running interactively, don't do anything
[[ $- != *i* ]] && return

## History: big, shared across terminals, no duplicates
HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T  '
shopt -s histappend cmdhist

## Behaviour
shopt -s autocd cdspell dirspell checkwinsize globstar extglob no_empty_cmd_completion
# key bindings and completion behaviour live in ~/.inputrc

## ShaniOS defaults: aliases, fzf, starship, zoxide, mcfly
# (inside a Distrobox container $HOME is shared but /usr isn't: use the host's)
for _f in /usr/share/shani/shell/common.sh /run/host/usr/share/shani/shell/common.sh; do
    [[ -r $_f ]] && { source "$_f"; break; }
done
unset _f

## Your own additions below
